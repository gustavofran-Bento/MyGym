<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: os dados do app (contas, diário) não vão para o backup na nuvem nem para outro celular. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
