<?xml version="1.0" encoding="utf-8"?>
<!-- Componente reutilizável: uma meta do dia (ícone + nome + valor). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/imageStatus"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:importantForAccessibility="no"
        tools:src="@drawable/ic_check_circle" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_m"
        android:layout_weight="1"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/mg_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Calorias" />

        <TextView
            android:id="@+id/textDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/mg_text_secondary"
            android:textSize="13sp"
            tools:text="2.950 de 3.250 kcal" />
    </LinearLayout>

    <TextView
        android:id="@+id/textStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="Bateu" />
</LinearLayout>
