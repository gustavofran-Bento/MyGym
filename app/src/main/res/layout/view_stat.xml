<?xml version="1.0" encoding="utf-8"?>
<!-- Componente reutilizável: bloco de estatística (valor + rótulo). Usado via <include>. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rounded_surface_high"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_s"
    android:paddingVertical="@dimen/space_m">

    <TextView
        android:id="@+id/textValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/mg_text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        tools:text="6" />

    <TextView
        android:id="@+id/textLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/mg_text_secondary"
        android:textSize="12sp"
        tools:text="Exercícios" />
</LinearLayout>
