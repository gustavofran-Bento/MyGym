<?xml version="1.0" encoding="utf-8"?>
<!-- Item da RecyclerView: um exercício. Toque alterna entre pendente/concluído. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardExercise"
    style="@style/MyGym.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/screen_padding"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="72dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="horizontal"
        android:padding="@dimen/card_padding">

        <TextView
            android:id="@+id/textNumber"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_circle_surface_high"
            android:gravity="center"
            android:textColor="@color/mg_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="1" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/mg_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Supino Reto" />

            <TextView
                android:id="@+id/textSetsReps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/mg_text_secondary"
                android:textSize="14sp"
                tools:text="4 séries × 10 reps" />

            <TextView
                android:id="@+id/textNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/mg_text_secondary"
                android:textSize="12sp"
                android:textStyle="italic"
                android:visibility="gone"
                tools:text="Controle a descida em 3 segundos"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/textWeight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill_primary_container"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/mg_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="30 kg" />
        </LinearLayout>

        <ImageView
            android:id="@+id/imageStatus"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:importantForAccessibility="no"
            tools:src="@drawable/ic_circle_outline" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
