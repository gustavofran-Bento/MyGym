<?xml version="1.0" encoding="utf-8"?>
<!-- TELA 2 — Detalhe do treino: cabeçalho com estatísticas + RecyclerView de exercícios. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.views.workout.WorkoutDetailActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/mg_background"
        app:navigationContentDescription="@string/navigate_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:titleTextColor="@color/mg_text_primary"
        tools:title="Peito + Tríceps" />

    <!-- FrameLayout empilha: conteúdo normal OU tela de erro -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/layoutContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- O cabeçalho rola junto com a lista (scrollFlags="scroll") -->
            <com.google.android.material.appbar.AppBarLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/mg_background"
                app:elevation="0dp"
                app:liftOnScroll="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/screen_padding"
                    android:paddingBottom="@dimen/space_s"
                    app:layout_scrollFlags="scroll">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="@dimen/badge_size"
                            android:layout_height="@dimen/badge_size"
                            android:background="@drawable/bg_circle_primary_container">

                            <TextView
                                android:id="@+id/textBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:textColor="@color/mg_primary"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                tools:text="A" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_l"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/textMuscleGroup"
                                style="@style/MyGym.Text.Overline"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="Empurrar" />

                            <TextView
                                android:id="@+id/textSummary"
                                style="@style/MyGym.Text.Title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                tools:text="6 exercícios • ~60 min" />
                        </LinearLayout>
                    </LinearLayout>

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/space_l" />

                    <!-- Componente reutilizável view_stat.xml incluído 3 vezes -->
                    <LinearLayout
                        android:id="@+id/layoutStats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/statExercises"
                            layout="@layout/view_stat"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <include
                            android:id="@+id/statSets"
                            layout="@layout/view_stat"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/space_s"
                            android:layout_weight="1" />

                        <include
                            android:id="@+id/statVolume"
                            layout="@layout/view_stat"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />
                    </LinearLayout>

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/space_l" />

                    <LinearLayout
                        android:id="@+id/layoutProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/textProgress"
                                style="@style/MyGym.Text.Body"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textStyle="bold"
                                tools:text="2 de 6 concluídos" />

                            <TextView
                                android:id="@+id/textProgressPercent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/mg_primary"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                tools:text="33%" />
                        </LinearLayout>

                        <Space
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/space_s" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progressWorkout"
                            style="@style/MyGym.Progress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="100"
                            app:indicatorColor="@color/mg_primary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.appbar.AppBarLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerExercises"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingVertical="@dimen/space_s"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_behavior="@string/appbar_scrolling_view_behavior"
                tools:itemCount="4"
                tools:listitem="@layout/item_exercise" />

            <!-- Estado VAZIO: treino sem exercícios (dia de descanso) -->
            <LinearLayout
                android:id="@+id/layoutEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_xxl"
                android:paddingTop="72dp"
                android:visibility="gone"
                app:layout_behavior="@string/appbar_scrolling_view_behavior">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_dumbbell" />

                <TextView
                    style="@style/MyGym.Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:gravity="center"
                    android:text="@string/detail_empty_title" />

                <TextView
                    style="@style/MyGym.Text.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:gravity="center"
                    android:text="@string/detail_empty_subtitle" />
            </LinearLayout>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>

        <!-- Estado de ERRO: id de treino inválido ou inexistente -->
        <LinearLayout
            android:id="@+id/layoutError"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_xxl"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_error_outline" />

            <TextView
                style="@style/MyGym.Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:gravity="center"
                android:text="@string/detail_error_title" />

            <TextView
                style="@style/MyGym.Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:gravity="center"
                android:text="@string/detail_error_subtitle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonErrorBack"
                style="@style/MyGym.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:paddingHorizontal="@dimen/space_xl"
                android:text="@string/detail_error_back" />
        </LinearLayout>
    </FrameLayout>

    <!-- Barra inferior fixa: adicionar exercício + finalizar -->
    <LinearLayout
        android:id="@+id/layoutBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/mg_surface"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingVertical="@dimen/space_m">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonAddExercise"
            style="@style/MyGym.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="@dimen/space_s"
            android:layout_weight="1"
            android:text="@string/detail_add_exercise"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonFinish"
            style="@style/MyGym.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.4"
            android:enabled="false"
            android:text="@string/detail_finish"
            app:icon="@drawable/ic_flag"
            app:iconGravity="textStart" />
    </LinearLayout>
</LinearLayout>
