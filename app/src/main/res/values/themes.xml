<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MyGym" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/mg_primary</item>
        <item name="colorOnPrimary">@color/mg_on_primary</item>
        <item name="colorPrimaryContainer">@color/mg_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/mg_primary</item>
        <item name="colorSecondary">@color/mg_primary</item>
        <item name="colorOnSecondary">@color/mg_on_primary</item>
        <item name="colorError">@color/mg_error</item>
        <item name="android:colorBackground">@color/mg_background</item>
        <item name="android:windowBackground">@color/mg_background</item>
        <item name="colorSurface">@color/mg_surface</item>
        <item name="colorSurfaceContainer">@color/mg_surface</item>
        <item name="colorSurfaceContainerLow">@color/mg_surface</item>
        <item name="colorSurfaceContainerHigh">@color/mg_surface_high</item>
        <item name="colorOnSurface">@color/mg_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/mg_text_secondary</item>
        <item name="colorOutline">@color/mg_outline</item>
        <!-- Cores "inversas" usadas pela Snackbar -->
        <item name="colorSurfaceInverse">@color/mg_surface_high</item>
        <item name="colorOnSurfaceInverse">@color/mg_text_primary</item>
        <item name="colorPrimaryInverse">@color/mg_primary</item>
        <item name="android:statusBarColor">@color/mg_background</item>
        <item name="android:navigationBarColor">@color/mg_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- ===== Estilos de texto reutilizáveis ===== -->
    <style name="MyGym.Text.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/mg_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="MyGym.Text.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/mg_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="MyGym.Text.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/mg_text_primary</item>
    </style>

    <style name="MyGym.Text.Secondary" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/mg_text_secondary</item>
    </style>

    <style name="MyGym.Text.Overline" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/mg_text_secondary</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ===== Card padrão do app ===== -->
    <style name="MyGym.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/mg_surface</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/mg_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- ===== Botão principal ===== -->
    <style name="MyGym.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/button_primary_bg</item>
        <item name="android:textColor">@color/button_primary_text</item>
        <item name="iconTint">@color/button_primary_text</item>
    </style>

    <!-- ===== Botão secundário (contorno) ===== -->
    <style name="MyGym.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeColor">@color/mg_outline</item>
        <item name="android:textColor">@color/mg_text_primary</item>
        <item name="iconTint">@color/mg_primary</item>
    </style>

    <!-- ===== Botão de texto (links) ===== -->
    <style name="MyGym.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/mg_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ===== Campo de texto dos formulários ===== -->
    <style name="MyGym.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="boxBackgroundColor">@color/mg_surface</item>
        <item name="hintTextColor">@color/mg_primary</item>
        <item name="android:textColorHint">@color/mg_text_secondary</item>
        <item name="startIconTint">@color/mg_text_secondary</item>
        <item name="endIconTint">@color/mg_text_secondary</item>
        <item name="errorTextColor">@color/mg_error</item>
        <item name="boxStrokeErrorColor">@color/mg_error</item>
    </style>

    <!-- ===== Botões de opção (sexo / objetivo) ===== -->
    <style name="MyGym.Toggle" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="backgroundTint">@color/toggle_bg</item>
        <item name="android:textColor">@color/toggle_text</item>
        <item name="strokeColor">@color/mg_outline</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
    </style>

    <!-- Item de legenda do gráfico (bolinha colorida + texto) -->
    <style name="MyGym.Legend" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:textColor">@color/mg_text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="drawableStartCompat">@drawable/bg_dot</item>
    </style>

    <!-- ===== Barra de progresso linear arredondada ===== -->
    <style name="MyGym.Progress" parent="Widget.Material3.LinearProgressIndicator">
        <item name="trackThickness">@dimen/progress_thickness</item>
        <item name="trackCornerRadius">4dp</item>
        <item name="trackColor">@color/mg_surface_high</item>
        <item name="trackStopIndicatorSize">0dp</item>
        <item name="indicatorTrackGapSize">0dp</item>
    </style>
</resources>
